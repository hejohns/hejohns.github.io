                    \begin {tikzcd}
                        A(F(-), a) \ar [r, Rightarrow, "(u∘-)"]\ar [d, Rightarrow, "≀"', "πₐ"] & A(F(-), b) \ar [d, Rightarrow, "≀"', "π_b"] \\
                        X(-, U(a)) \ar [r, Rightarrow, "(\overline {U}(u)∘-)"] & X(-, U(b))
                    \end {tikzcd}
                ]]></fr:embedded-tex-body></fr:embedded-tex></fr:mainmatter><fr:backmatter /></fr:tree>
            and clearly <fr:tex
