    <fr:title text="The Uses and Abuses of the History of Topos Theory">The Uses and Abuses of the History of Topos Theory</fr:title>
    <fr:taxon>Reference</fr:taxon>
  </fr:frontmatter>
  <fr:mainmatter>
    <fr:tree show-metadata="false">
      <fr:frontmatter>
