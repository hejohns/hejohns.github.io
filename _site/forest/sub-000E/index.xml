    \usepackage {unicode-math} ]]></fr:resource-source><fr:resource-source type="latex" part="body"><![CDATA[
            \begin {tikzcd}
                X(y, Ua)×X(x, y) \ar [r, "π_{y, a}⁻¹×\overline {F}"]\ar [d, "∘"] & A(Fy, a)×A(Fx, Fy) \ar [d, "∘"] \\
                X(x, Ua) \ar [r, "π_{x, a}⁻¹"] & A(Fx, a)
            \end {tikzcd}
