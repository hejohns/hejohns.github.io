href="hejohns.xml"
type="local"
addr="hejohns">Johnson He</fr:link></fr:author></fr:authors><fr:parent>#218</fr:parent></fr:frontmatter><fr:mainmatter>
        <fr:embedded-tex
hash="b806fb8c112337fe6c4b4a1e244b5d97"><fr:embedded-tex-preamble>\usepackage {tikz-cd}\usepackage {unicode-math}</fr:embedded-tex-preamble><fr:embedded-tex-body>
            \begin {tikzcd}
                A(a, b)×A(Fx, a) \ar [r, "\overline {U}×π_{a,x}"]\ar [d, "∘"] &amp; X(Ua, Ub)×X(x, Ua) \ar [d, "∘"] \\
                A(Fx, b) \ar [r, "π_{x, b}"] &amp; X(x, Ub)
            \end {tikzcd}
        </fr:embedded-tex-body></fr:embedded-tex>
</fr:mainmatter></fr:tree><fr:tree
